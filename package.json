{
  "name": "beijing-life",
  "version": "0.1.0",
  "private": true,
  "description": "北京生活 — a Chinese-learning life sim that runs in a browser with no build step. There is nothing to install: the scripts here drive the dev server and the test harnesses, which need only Node and a Chrome on the machine.",
  "scripts": {
    "start": "python3 serve.py 8000",
    "test": "node .verify.js",
    "test:fast": "node .verify.js --fast",
    "verify": "node .verify.js",
    "record": "node .verify.js --record",
    "tools": "node .verify.js --list",
    "mall:verify": "node .verify.js mall",
    "mall:visual:check": "node .mallvisualcheck.js --validate && node .mallvisualdiff.js --self-test",
    "mall:visual:plan": "node .mallvisualcheck.js --plan",
    "mall:visual:capture": "node .mallvisualcheck.js --anchors",
    "mall:visual:diff": "node .mallvisualdiff.js",
    "mall:supplemental:public:plan": "node .mallsupplementalvisual.js --validate",
    "mall:supplemental:public:capture": "node .mallsupplementalvisual.js --capture",
    "mall:supplemental:public:check": "node .mallsupplementalvisual.js --check",
    "mall:supplemental:tenants:plan": "node .malltenantsupplementcheck.js --validate-plan",
    "mall:supplemental:tenants:capture": "node .malltenantvisualcheck.js --all",
    "mall:supplemental:tenants:check": "node .malltenantsupplementcheck.js",
    "mall:routes": "node .mallroutecheck.js",
    "mall:budgets": "node .mallbudgetcheck.js",
    "mall:materials": "node .mall-material-sourcecheck.js",
    "mall:glyphs": "node .mall-glyph-stability-check.js",
    "mall:floors": "node .mall-floor-sourcecheck.js",
    "mall:foodlife": "node .mall-foodlife-sourcecheck.js",
    "mall:entrance": "node .mall-entrance-sourcecheck.js",
    "mall:reflections": "node .mall-reflection-sourcecheck.js",
    "mall:daylight": "node .mall-daylight-sourcecheck.js",
    "mall:exposure": "node .mall-exposure-check.js --self-test",
    "mall:render:audit": "node .mall-render-audit.js",
    "mall:exterior:life": "node .mall-exterior-life-sourcecheck.js",
    "mall:food:lighting": "node .mall-food-lighting-sourcecheck.js",
    "mall:runtime:guards": "node .mall-runtime-guard-sourcecheck.js",
    "mall:events": "node .mall-events-sourcecheck.js",
    "mall:quality": "node .mall-quality-sourcecheck.js",
    "mall:state": "node .mallstatecheck.js",
    "mall:truth": "node .malltruthcheck.js",
    "mall:promotions": "node .mall-promotion-state-sourcecheck.js",
    "mall:cast:life": "node .mall-accessible-cast-sourcecheck.js",
    "mall:cast:awake": "node .mall-special-cast-awake-sourcecheck.js",
    "mall:carry": "node .mall-carry-distribution-sourcecheck.js",
    "mall:perf:check": "node .fpscheck.js --validate-profiles",
    "mall:perf:accept:plan": "node .fpscheck.js --validate-profiles --mall-acceptance",
    "mall:perf:profiles": "PLAY=1 node .fpscheck.js --mall-profiles",
    "mall:perf:accept": "PLAY=1 node .fpscheck.js --mall-acceptance --artifact=.mall-upgrade/mall-performance-acceptance.json",
    "mall:release:validate": "node .mall-release-check.js --validate",
    "mall:release:review": "node .mall-release-check.js --review-template",
    "mall:release:promote": "node .mall-release-check.js --promote-baseline",
    "mall:release": "node .mall-release-check.js",
    "boot": "node .bootcheck.js",
    "places": "node .places.js",
    "campus:check": "node .campuscheck.js",
    "campus:static": "node campus-static-check.js",
    "campus:interiors:blueprint": "node tools/generate-university-interiors-blueprint.js",
    "campus:interiors:spacing": "node tools/audit-university-interior-spacing.js",
    "campus:interiors": "node campus-interior-check.js",
    "campus:interiors:visual": "node university-visual-review.js",
    "perf": "node .perfcheck.js",
    "save": "node .savecheck.js",
    "shop": "node .shoptest.js",
    "dict": "node .dictcheck.js",
    "tower": "node .towercheck.js",
    "figure": "node .figsheet.js",
    "rig": "node .rigcheck.js assets/rigs/XiaoChen.glb",
    "rig:lod": "node .riglodcheck.js",
    "rig:motion": "node .rigmotioncheck.js",
    "rig:memory": "node .rigmemorycheck.js",
    "cast": "python3 tools/characters/resolve_cast.py --count",
    "cast:dry": "python3 tools/characters/resolve_cast.py --dry-run",
    "cast:build": "python3 tools/characters/build_cast_batch.py --workers 2",
    "cast:assets": "node .castassetcheck.js",
    "cast:runtime": "node .castruntimecheck.js",
    "cast:live": "node .livecastcheck.js --assert",
    "npc:behavior": "node .npcbehaviorcheck.js",
    "npc:fluidity": "node .npcfluiditycheck.js",
    "npc:items": "node .npcitemcheck.js",
    "npc:seats": "node .sitcheck.js",
    "traffic": "node .streettrafficcheck.js",
    "cast:visual": "node .fullcastvisual.js",
    "roster": "node .rostercheck.js",
    "zoo": "node .shot.js zoostudio.html .zoo-all.png \"S.all=true; S.dist=15; S.tgt=1.4; S.pitch=0.14;\"",
    "shots": "node .audit.js",
    "lines": "node .dumplines.js"
  },
  "engines": { "node": ">=22" }
}
